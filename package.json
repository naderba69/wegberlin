  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "offline:manifest": "node scripts/generate-offline-manifest.mjs",
    "prebuild": "npm run offline:manifest",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
